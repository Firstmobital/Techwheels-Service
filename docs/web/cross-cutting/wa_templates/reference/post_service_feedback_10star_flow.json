{
  "version": "7.3",
  "screens": [
    {
      "id": "FEEDBACK_10_STAR",
      "title": "Service Feedback",
      "terminal": true,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "psf_feedback_form",
            "children": [
              {
                "type": "TextSubheading",
                "text": "How would you rate your service experience?"
              },
              {
                "type": "TextCaption",
                "text": "Select a score from 10 (Excellent) to 1 (Very Poor)."
              },
              {
                "type": "RadioButtonsGroup",
                "name": "rating_10",
                "label": "Your Rating (1 to 10)",
                "required": true,
                "data-source": [
                  { "id": "10", "title": "10/10 — Excellent" },
                  { "id": "9", "title": "9/10 — Great" },
                  { "id": "8", "title": "8/10 — Very Good" },
                  { "id": "7", "title": "7/10 — Good" },
                  { "id": "6", "title": "6/10 — Satisfactory" },
                  { "id": "5", "title": "5/10 — Average" },
                  { "id": "4", "title": "4/10 — Below Average" },
                  { "id": "3", "title": "3/10 — Poor" },
                  { "id": "2", "title": "2/10 — Very Poor" },
                  { "id": "1", "title": "1/10 — Extremely Poor" }
                ]
              },
              {
                "type": "TextArea",
                "name": "remarks",
                "label": "Remarks / Suggestions (Optional)",
                "required": false,
                "max-length": 500
              },
              {
                "type": "Footer",
                "label": "Submit Feedback",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "flow_version": "psf_10_star_v2",
                    "rating_scale": "10",
                    "rating_10": "${form.rating_10}",
                    "remarks": "${form.remarks}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
