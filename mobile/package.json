{
  "name": "techwheels-service-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:prod:android": "npx --yes eas-cli build -p android --profile production",
    "build:prod:apk": "npx --yes eas-cli build -p android --profile production-apk",
    "build:prod:ios": "npx --yes eas-cli build -p ios --profile production",
    "build:prod:ios:internal": "npx --yes eas-cli build -p ios --profile production-internal-ios",
    "build:preview:apk": "npx --yes eas-cli build -p android --profile preview",
    "build:preview:ios": "npx --yes eas-cli build -p ios --profile preview",
    "ota:prod:all": "npx --yes eas-cli update --environment production --branch production --platform all --non-interactive --message \"production ota update\"",
    "ota:prod": "npm run ota:prod:all",
    "ota:prod:ios": "npx --yes eas-cli update --environment production --branch production --platform ios --non-interactive --message \"production ota ios update\"",
    "ota:preview": "npx --yes eas-cli update --branch preview --platform all --non-interactive --message \"preview ota update\"",
    "check:native-deps": "node scripts/check-native-deps.js",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/native": "^7.2.5",
    "@supabase/supabase-js": "^2.103.3",
    "classnames": "^2.5.1",
    "csv-parse": "^6.1.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "expo": "~57.0.0",
    "expo-application": "~57.0.3",
    "expo-background-fetch": "~57.0.19",
    "expo-build-properties": "~57.0.21",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-local-authentication": "~57.0.3",
    "expo-location": "~57.0.19",
    "expo-notifications": "~57.0.20",
    "expo-print": "~57.0.2",
    "expo-router": "^57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-task-manager": "~57.0.19",
    "expo-updates": "~57.0.23",
    "html2canvas": "^1.4.1",
    "iconv-lite": "^0.7.0",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "lucide-react": "^0.544.0",
    "lucide-react-native": "^1.17.0",
    "nativewind": "^4.x",
    "papaparse": "^5.5.3",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-aws3": "^0.0.9",
    "react-native-css-interop": "^0.2.4",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.24",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.4",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^8.57.0",
    "patch-package": "^8.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-navigation/native"
      ]
    }
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.x"
  }
}
